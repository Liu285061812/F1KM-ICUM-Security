                          92 --86:  * Function name:  R_FDL_Init
                          93 --87:  *********************************************************************************************************************/
                          94 --88: /**
                          95 --89:  * User interface function:
                          96 --90:  * This function initializes the FDL. It must be called before any execution of a FDL function.
                          97 --91:  * Sequence:
                          98 --92:  * - Call the function to initialize the library RAM and do parameter checks
                          99 --93:  * If compatibility mode is used then:
                         100 --94:  * - Call the function to initialize the FCU RAM
                         101 --95:  * - Call the function to set the frequency information with frequency check
                         102 --96:  *   - Frequency is within reasonable range between R_FCU_FMIN and R_FCU_FMAX
                         103 --97:  *
                         104 --98:  * In error case the library is set to not initialized (R_FDL_ISTAT_NOINIT)
                         105 --99:  *
                         106 --100:  * @param[in]  descriptor_pstr - Pointer to the FDL descriptor structure
                         107 --101:  * @return     Initialization status when returned from function call:
                         108 --102:  *             - R_FDL_OK                - Initialization was successful
                         109 --103:  *             - R_FDL_ERR_CONFIGURATION - FDL configuration parameter error
                         110 --104:  *             If compatibility mode is used then following error codes may be returned:
                         111 --105:  *             - R_FDL_ERR_PROTECTION    - Programming hardware reset was prohibited

                                                                      Page 3
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_00010ls1.s
                         112 --106:  *             - R_FDL_ERR_INTERNAL      - Internal (HW) error during HW initialization
                         113 --107:  */
                         114 --108: /*********************************************************************************************************************/
                         115 --109: /*********************************************************************************************************************
                         116 --110:  * MISRA Rule:   MISRA-C 2004 rule 14.1 (QAC message 1503)
                         117 --111:  * Reason:       This function is not used within the library, it is only used by the user
                         118 --112:  *               application.
                         119 --113:  * Verification: This function is part of the library API and therefore essential on the one hand.
                         120 --114:  *               On the other hand the QAC warning is correct, because this function is never
                         121 --115:  *               called within the library. To solve this dilemma it is necessary and suitable
                         122 --116:  *               to disable the message.
                         123 --117:  *********************************************************************************************************************/
                         124 --118: #ifdef R_FDL_LIB_V1_COMPATIBILITY
                         125 --119:     r_fdl_status_t R_FDL_Init (const r_fdl_descriptor_t * descriptor_pstr)                         /* PRQA S 1503 */
                         126 --120:     {
                         127 --121:         r_fdl_status_t  ret;
                         128 --122:         r_fdl_request_t request;
                         129 --124:         ret = R_FDL_InitVariables (descriptor_pstr);
                         130 --126:         /* Init_Variables already does some configuration checks */
                         131 --127:         if (R_FDL_OK == ret)
                         132 --128:         {
                         133 --129:             request.command_enu = R_FDL_CMD_PREPARE_ENV;
                         134 --130:             R_FDL_Execute (&request);
                         135 --132:             while (R_FDL_BUSY == request.status_enu)
                         136 --133:             {
                         137 --134:                 R_FDL_Handler ();
                         138 --135:             }
                         139 --137:             ret = request.status_enu;
                         140 --138:         }
                         141 --140:         return (ret);
                         142 --141:     } /* R_FDL_Init */
                         143 --142: #else
                         144 --143:     r_fdl_status_t R_FDL_Init (const r_fdl_descriptor_t * descriptor_pstr)                         /* PRQA S 1503 */
