                        3015 --1563:     /* ----- Switch ON BFA ----- */
                        3016 --1564:     asm (" movea 0x01, r0, r8                   ");     /* Hard coded BFASEL value to switch on EXA3*/
                        3017 --1565:     asm (" br _R_FDL_FCUFct_InitRAM_Asm_SWBFA   ");
                        3018 --1567:     asm (" _R_FDL_FCUFct_InitRAM_Asm_Copy:      ");
                        3019 --1569:     /* Copy FW to RAM */
                        3020 --1570:     /* r7: src, r8: dest, r9: cnt, */
                        3021 --1571:     /* r10: read buffer */
                        3022 --1572:     asm (" ld.w 0[r6], r7                       ");
                        3023 --1573:     asm (" ld.w 4[r6], r8                       ");
                        3024 --1574:     asm (" ld.w 8[r6], r9                       ");
                        3025 --1576:     asm (" _R_FDL_FCUFct_InitRAM_Asm_Loop:      ");

