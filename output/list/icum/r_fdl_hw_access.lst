                        1733 --768: /**
                        1734 --769:  * Use intrinsic functions to evaluate BWC address from PID register
                        1735 --770:  *
                        1736 --771:  * @param      -
                        1737 --772:  * @return     BWC register address, 0x00000000uL  if no BWC available
                        1738 --773:  */
                        1739 --774: /*********************************************************************************************************************/
                        1740 --775: #if ((defined R_FDL_INNER_NO_BFA_SWITCH) && (defined R_FDL_INNER_NO_FCU_COPY))
                        1741 --776: #else
                        1742 --778: #define R_FDL_START_SEC_PUBLIC_CODE
                        1743 --779: #include "r_fdl_mem_map.h"                                                                          /* PRQA S 5087 */
                        1744 --780: R_FDL_STATIC uint32_t R_FDL_IFct_GetBWCAdd (void)
                        1745 --781: {
                        1746 --782:     uint32_t bwc;
                        1747 --783:     uint32_t pid;
                        1748 --785:     /* regID 6, selID 1 */
                        1749 --786:     #if R_FDL_COMPILER == R_FDL_COMP_GHS
                        1750 --787:     pid = __STSR (R_SYSTEM_REGISTER_PID);
                        1751 --788:     #elif R_FDL_COMPILER == R_FDL_COMP_IAR
                        1752 --789:     pid = __STSR (R_SYSTEM_REGISTER_PID);
                        1753 --790:     #elif R_FDL_COMPILER == R_FDL_COMP_REC
                        1754 --791:     pid = __stsr_rh (R_SYSTEM_REGISTER_PID);
                        1755 --792:     #endif
                        1756 --794:     pid &= R_PID_CORE_MASK;    /* Extract bits 5~7 */
                        1757 --796:     /* G3K core */
                        1758 --797:     if (R_PID_CORE_G3K == pid)
                        1759 --798:     {
                        1760 --799:         bwc = R_BWCBUF_G3K_ADD;
                        1761 --800:     }
                        1762 --801:     
                        1763 --802:     /* G3KH core */
                        1764 --803:     else if (R_PID_CORE_G3KH == pid)
                        1765 --804:     {
                        1766 --805:         bwc = R_BWCBUF_G3KH_ADD;
                        1767 --806:     }
                        1768 --807:     
                        1769 --808:     /* No G3K code --> no BWC buffer */
                        1770 --809:     else
                        1771 --810:     {
                        1772 --811:         bwc = 0x00000000uL;
                        1773 --812:     }
                        1774 --814:     return (bwc);
                        1775 --815: } /* R_FDL_IFct_GetBWCAdd */
