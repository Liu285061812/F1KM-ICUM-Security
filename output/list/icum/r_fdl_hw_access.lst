                        4493 --2344: /*********************************************************************************************************************
                        4494 --2345:  * Function name:  R_FDL_FCUFct_ReadOperation
                        4495 --2346:  *********************************************************************************************************************/
                        4496 --2347: /**
                        4497 --2348:  * This function reads data from the Data Flash. Doing so, it disables the ECC error interrupts to
                        4498 --2349:  * avoid interrupt generation on accepted ECC errors when reading e.g. blank or partly written
                        4499 --2350:  * Flash words. Instead, the error and fail address is returned to the calling function.
                        4500 --2351:  * Note: Detecting a single bit error does not stop reading the Data Flash. Instead, the error
                        4501 --2352:  *       is returned together with the fail address and the user application / EEL can still
                        4502 --2353:  *       judge if it trusts the data. If later on a double bit error is detected, the function
                        4503 --2354:  *       stop reading the data and the single bit error indication and address is overwritten
                        4504 --2355:  *       with the double bit error indication and address
                        4505 --2356:  *
                        4506 --2357:  * @param[in,out]  pAddSrc_u32 \n
                        4507 --2358:  *                 in:  Data Flash src address (byte index) to read. \n
                        4508 --2359:  *                 out: In ECC error case the fail address is returned
                        4509 --2360:  * @param[in]      addDest_u32 - destination buffer address
                        4510 --2361:  * @param[in]      cnt_u32 - number of words to read
                        4511 --2362:  *
                        4512 --2363:  * @return     Parameter check result:
                        4513 --2364:  *             - R_FDL_OK
                        4514 --2365:  *             - R_FDL_ERR_ECC_SED (Single bit error detected during read)
                        4515 --2366:  *             - R_FDL_ERR_ECC_DED (Double bit error detected during read)
                        4516 --2367:  */
                        4517 --2368: /*********************************************************************************************************************/
                        4518 --2369: #define R_FDL_START_SEC_PUBLIC_CODE
                        4519 --2370: #include "r_fdl_mem_map.h"                                                                          /* PRQA S 5087 */
