                        3325 --1919: #include "r_fdl_mem_map.h"                                                                          /* PRQA S 5087 */
                        3326 --1920: R_FDL_STATIC void R_FDL_IFct_ExeCodeInRAM (r_fdl_pFct_ExeInRAM pFct, uint32_t * param_pu32)
