                        1890 --876: /*********************************************************************************************************************
                        1891 --877:  * Function name:  R_FDL_IFct_GetFWParam_Asm
                        1892 --878:  *********************************************************************************************************************/
                        1893 --879: /**
                        1894 --880:  * Assembler function to read out a firmware parameter from the Extra area
                        1895 --881:  * The cache clear check loop is timeout supervised
                        1896 --882:  *
                        1897 --883:  * Note: the code for GHS, IAR and CC-RL is basically equal, only the style is compiler dependent and so, different.
                        1898 --884:  *       GHS code is fully commented, while the IAR and CC-RL code is partly or not commented. Refer to GHS comments
                        1899 --885:  *       to understand the code.
                        1900 --886:  *
                        1901 --887:  * @param[in,out]  param_pu32 \n
                        1902 --888:  *                 in  - Address to read \n
                        1903 --889:  *                 out - Read value
                        1904 --890:  * @return     ---
                        1905 --891:  */

                                                                      Page 33
                                                              C:\Users\a5152492\AppData\Local\Temp\gh_0000tvs1.s
                        1906 --892: /*********************************************************************************************************************/
                        1907 --893: /*********************************************************************************************************************
                        1908 --894:  * MISRA Rule:   MISRA-C 2004 rule 3.1 (QAC message 3006)
                        1909 --895:  * Reason:       This function contains a mixture of in-line assembler statements and C statements.
                        1910 --896:  *               The function is copied to RAM into a memory range of fix size. So, the function itself must have a
                        1911 --897:  *               fix size which cannot be realized by a c-compiler. So, the function is written in Assembler
                        1912 --898:  * Verification: Review of the c-interface (only temporary registers are used and the stack size is unchanged
                        1913 --899:  *********************************************************************************************************************/
                        1914 --900: /*********************************************************************************************************************
                        1915 --901:  * MISRA Rule:   MISRA-C 2004 rule 3.1 (QAC message 1006)
                        1916 --902:  * Reason:       In-line assembler construct is a language extension. The code has been ignored.
                        1917 --903:  * Verification: -
                        1918 --904:  *********************************************************************************************************************/
                        1919 --905: /*********************************************************************************************************************
                        1920 --906:  * MISRA Rule:   MISRA-C 2004 rule 3.1 (QAC message 3206)
                        1921 --907:  * Reason:       function parameter seems to be not used in the function as no c-code relates on
                        1922 --908:  *               it, but the assembler code uses the parameter
                        1923 --909:  * Verification: -
                        1924 --910:  *********************************************************************************************************************/
                        1925 --912: #ifdef R_FDL_INNER_NO_BFA_SWITCH
                        1926 --913: #else
                        1927 --915: #define R_FDL_START_SEC_PUBLIC_CODE
                        1928 --916: #include "r_fdl_mem_map.h"                                                                          /* PRQA S 5087 */
                        1929 --918: R_FDL_COV_SAVEOFF
                        1930 --920: #ifdef ENABLE_QAC_TEST
                        1931 --921:     #pragma PRQA_MESSAGES_OFF 1006
                        1932 --922: #endif
                        1933 --924: #if R_FDL_COMPILER == R_FDL_COMP_GHS
                        1934 --925: R_FDL_STATIC void R_FDL_IFct_GetFWParam_Asm (uint32_t * param_pu32)                             /* PRQA S 3006,3206 */
                        1935 --926: {
                        1936 --927:     /* GHS compilers use r6~r9 as scratch registers.
                        1937 --928:        r6: parameter address
                        1938 --929:        r7, r9: work register
                        1939 --930:        r8: value for switch BFA on/off
                        1940 --931:     */
                        1941 --933:     /* ----- Switch ON BFA ----- */
                        1942 --934:     asm (" mov 0x01, r8                         ");     /* Hard coded BFASEL value to switch on EXA3*/
                        1943 --935:     asm (" br _R_FDL_IFct_GetFWParam_Asm_SWBFA  ");
                        1944 --937:     asm (" _R_FDL_IFct_GetFWParam_Asm_Read:     ");
                        1945 --939:     /* Read requested data as one aligned word */
