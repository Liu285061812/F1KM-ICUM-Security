                         145 --146: /*********************************************************************************************************************
                         146 --147:  * Function name:  R_FDL_InitVariables
                         147 --148:  *********************************************************************************************************************/
                         148 --149: /**
                         149 --150:  * Part of the R_FDL_Init function.
                         150 --151:  * This function initializes the FDL internal variables and does the FDL configuration parameter checks.
                         151 --152:  * The following parameter checks are done:
                         152 --153:  * - Descriptor variable is defined
                         153 --154:  * - FDL pool is defined
                         154 --155:  * - EEL pool is within FDL pool
                         155 --156:  *
                         156 --157:  * In error case the library is set to not initialized (R_FDL_ISTAT_NOINIT)
                         157 --158:  *
                         158 --159:  * @param[in]  descriptor_pstr - Pointer to the FDL descriptor structure
                         159 --160:  * @return     Initialization status when returned from function call:
                         160 --161:  *             - R_FDL_OK                - Initialization was successful
                         161 --162:  *             - R_FDL_ERR_CONFIGURATION - FDL configuration parameter error
                         162 --163:  */
                         163 --164: /*********************************************************************************************************************/
                         164 --165: /*********************************************************************************************************************
                         165 --166:  * MISRA Rule:   MISRA-C 2004 rule 8.8 (QAC message 3408)
                         166 --167:  * Reason:       Library is delivered as source code and as a precompiled object.
                         167 --168:  *               The file r_fdl_user_if_init.c is not included on generation of the precompiled object.
                         168 --169:  *               It is delivered as a separate file and cannot include any other header files, except the
                         169 --170:  *               defined interface header files. The function is a library internal function and its declaration
                         170 --171:  *               is not part of the interface header files.
                         171 --172:  * Verification: -
                         172 --173:  *********************************************************************************************************************/

