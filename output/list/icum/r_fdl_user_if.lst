                        3391 --1345: /*********************************************************************************************************************
                        3392 --1346:  * Function name:  R_FDL_Standby
                        3393 --1347:  *********************************************************************************************************************/
                        3394 --1348: /**
                        3395 --1349:  * User interface function:
                        3396 --1350:  * Prepares the HW for fast standby entry:
                        3397 --1351:  * - on write end erase
                        3398 --1352:  * - blank check is not suspendable, here the function is without effect
                        3399 --1353:  *
                        3400 --1354:  * This function can be called asynchronous (e.g. interrupt function) and so need to take
                        3401 --1355:  * care of the current hardware status in order to restore it later on during wakeup
                        3402 --1356:  *
                        3403 --1357:  * Note:
                        3404 --1358:  * the function need to be called continuously until the result is != R_FDL_BUSY
                        3405 --1359:  *
                        3406 --1360:  * @param[in,out]   -
                        3407 --1361:  * @return          result of the standby operation
                        3408 --1362:  *                  - R_FDL_OK           - Flash hardware is in standby or ready (no more Flash operation)
                        3409 --1363:  *                  - R_FDL_BUSY         - Flash hardware is still busy. Repeat calling the function
                        3410 --1364:  *                  - R_FDL_ERR_REJECTED - Rejected, as the library is not initialized
                        3411 --1365:  */
                        3412 --1366: /*********************************************************************************************************************/
                        3413 --1367: #define R_FDL_START_SEC_PUBLIC_CODE
