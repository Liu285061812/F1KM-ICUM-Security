#!gbuild
primaryTarget=v800_standalone.tgt
[Program]
	-G
	-object_dir=output/objects/icum
	-map
	-gsize
	-e _RESET
	-list
	-list_dir=output/list/icum
	-passsource
	-Mx
	-bsp generic
	-sda=all
	-callgraph
	-o output/icum
	:postexec='gmemfile output/icum -o output/icum.mem'
	:postexec='gsrec -e 0 -hex386 output/icum -o output/icum.hex'
	:postexec='gsrec -e 0 -noS5 output/icum -o output/icum.rec'
	--no_additional_output
	-I.
	-I..
	-I..\FDL
	-I..\FDL\lib
	-I..\..\device
	-fsoft
	-cpu=rh850
	-ansi
[Subproject]
ICUM.ld
dr7f701649_startup_icum.850
dr7f701649i.dvf.h
..\..\device\dr7f701649.dvf.h
..\..\device\dr7f701649_irq.h
..\..\device\device.h
..\..\device\icu_feret.h
..\..\device\io_macros_v2.h
..\..\device\cpu.h
dr7f701649_irq_icum.h
..\shared_memory.h
..\FDL\fdl_cfg.h
..\FDL\r_fdl.h
..\FDL\r_fdl_types.h
..\FDL\lib\r_fdl_env.h
..\FDL\lib\r_fdl_global.h
..\FDL\lib\r_fdl_hw_access.c
..\FDL\lib\r_fdl_mem_map.h
..\FDL\lib\r_fdl_user_if.c
..\FDL\lib\r_fdl_user_if_init.c
..\FDL\lib\r_typedefs.h
icum_fdl.c
icum_fdl.h
fdl_test.c
fdl_test.h
icum_crypto.c
icum_crypto.h
aes_test.c
aes_test.h
icum_hash.c
icum_hash.h
hash_test.c
hash_test.h
icum_rsa.c
icum_rsa.h
rsa_test.c
rsa_test.h
icum_comm.c
icum_comm.h
icum_flash_handoff.c
icum_flash_handoff.h
..\icum_flash_handoff_protocol.h
icum_ostm.c
icum_ostm.h
main.c
..\..\debug\debug.gpj [Subproject]